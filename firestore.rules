rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Usuarios: Cualquiera autenticado lee; solo el dueño o la Admin modifican el saldo
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
    }

    // 2. Transacciones/Movimientos: Se permite crear a cualquier usuario autenticado
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.user_ref == request.auth.uid || 
        resource.data.from_uid == request.auth.uid || 
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
      allow create: if request.auth != null;
    }

    // 3. Solicitudes de Retiro: Creación por usuarios, lectura y edición por Admin/dueño
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
    }

    // 4. Notificaciones: Permitir creación y lectura al destinatario o Admin
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid
      );
    }

    // 5. Chat / Mensajes
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.participants
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.token.email in ['gabyhuchy@gmail.com', 'gabyhuchy@hotmail.com']
      );
    }
  }
}
