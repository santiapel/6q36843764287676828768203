rules_version = '2';

// ─────────────────────────────────────────────────────────────
// REGLAS DE SEGURIDAD - MOM COIN BANK
// ─────────────────────────────────────────────────────────────
// Estas reglas resuelven el error "Missing or insufficient permissions"
// permitiendo acceso SOLO a las cuentas familiares autorizadas (no a
// cualquier usuario de internet), y solo a lo que cada rol necesita.
//
// IMPORTANTE (léase antes de subir a producción):
// El campo "balance" puede ser modificado por cualquier miembro
// autenticado porque las transferencias y el pago de tareas se hacen
// desde el cliente (sin backend). Esto es razonable para una app
// familiar de confianza, pero NO es el nivel de seguridad de un banco
// real: un usuario mal intencionado con acceso a la consola del
// navegador podría, en teoría, escribir su propio balance. El único
// modo 100% seguro de evitar esto es mover la lógica de transferencias
// y pagos a una Cloud Function (con Admin SDK) y bloquear la escritura
// directa de "balance" desde el cliente. Te dejo la nota igual en la
// respuesta por si más adelante querés dar ese paso.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Cuentas de la familia autorizadas a usar la app.
    function isMember() {
      return signedIn() && request.auth.token.email in [
        'santipapel16@gmail.com',
        'leoxdfunes@gmail.com',
        'gabyhuchy@gmail.com',
        'gabyhuchy@hotmail.com'
      ];
    }

    // Solo mamá administra retiros, tareas y usuarios.
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'gabyhuchy@gmail.com',
        'gabyhuchy@hotmail.com'
      ];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ── USUARIOS (saldo, nombre, pin) ──────────────────────────
    match /users/{userId} {
      allow read: if isMember();

      // Un usuario puede crear su propio documento (primer login).
      allow create: if isMember() && isOwner(userId);

      // El dueño puede editar su nombre/pin, pero NO su propio balance.
      // Cualquier miembro puede ajustar el campo "balance" de CUALQUIER
      // usuario (necesario para transferencias P2P y pago de tareas desde
      // el cliente). Ver nota de seguridad arriba.
      allow update: if isMember() && (
        (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0)
      );

      allow delete: if isAdmin();
    }

    // ── MOVIMIENTOS (historial, solo lectura de lo propio) ─────
    match /transactions/{txId} {
      allow read: if isMember() && (isAdmin() || resource.data.user_ref == request.auth.uid);
      allow create: if isMember();
      allow update, delete: if false; // los movimientos nunca se editan/borran
    }

    // ── RETIROS ─────────────────────────────────────────────────
    match /withdrawals/{id} {
      // Cada miembro puede leer sus propios retiros; mamá los lee todos.
      allow read: if isMember() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // aprobar / rechazar / programar
      allow delete: if isAdmin();
    }

    // ── NOTIFICACIONES INTERNAS (in-app) ───────────────────────
    match /notifications/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update: if isMember();
      allow delete: if isAdmin();
    }

    // ── TAREAS ──────────────────────────────────────────────────
    match /tasks/{id} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow update: if isMember(); // completar (miembro) o aprobar (admin)
      allow delete: if isAdmin();
    }

    // Cualquier otra colección: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
